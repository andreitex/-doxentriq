ARG GO_IMAGE
ARG DOCKER_CLI_IMAGE
FROM ${GO_IMAGE} AS build
ENV GOTOOLCHAIN=local
RUN test "$(go env GOVERSION)" = "go1.27.3"
WORKDIR /src
COPY services/runtime/go.mod services/runtime/go.sum ./
RUN go mod download
COPY services/runtime ./
RUN go test ./... && go vet ./... && CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /runtime .
FROM ${DOCKER_CLI_IMAGE}
ARG GIT_VERSION
ARG ZLIB_VERSION
# Trusted company image only. These optional Docker CLI plugins are never used
# by the broker; preserve the core CLI, CA payload and other package identities.
RUN set -euo pipefail; \
    for version in "${GIT_VERSION}" "${ZLIB_VERSION}"; do \
      test "${#version}" -le 64; \
      case "${version}" in ''|*[!0-9.r-]*) exit 1;; esac; \
      printf '%s\n' "${version}" | grep -Eq '^[0-9]+(\.[0-9]+){1,3}-r[0-9]+$'; \
    done; \
    test ! -e /etc/apk/config; test ! -e /lib/apk/config; \
    test -f /usr/local/bin/docker; test ! -L /usr/local/bin/docker; \
    test -f /etc/ssl/certs/ca-certificates.crt; test ! -L /etc/ssl/certs/ca-certificates.crt; \
    docker_sha="$(sha256sum /usr/local/bin/docker | cut -d ' ' -f 1)"; \
    ca_sha="$(sha256sum /etc/ssl/certs/ca-certificates.crt | cut -d ' ' -f 1)"; \
    test -f /usr/local/libexec/docker/cli-plugins/docker-buildx; \
    test ! -L /usr/local/libexec/docker/cli-plugins/docker-buildx; \
    test "$(stat -c %h /usr/local/libexec/docker/cli-plugins/docker-buildx)" = 1; \
    test -f /usr/local/libexec/docker/cli-plugins/docker-compose; \
    test ! -L /usr/local/libexec/docker/cli-plugins/docker-compose; \
    test "$(stat -c %h /usr/local/libexec/docker/cli-plugins/docker-compose)" = 1; \
    if test -e /usr/local/bin/docker-compose || test -L /usr/local/bin/docker-compose; then \
      test -L /usr/local/bin/docker-compose; \
      test "$(readlink /usr/local/bin/docker-compose)" = /usr/local/libexec/docker/cli-plugins/docker-compose; \
    fi; \
    package_dir="$(mktemp -d /tmp/autosoft-runtime-packages.XXXXXX)"; \
    : > "${package_dir}/empty-config"; export APK_CONFIG="${package_dir}/empty-config"; \
    apk --no-network --repositories-file /dev/null info -v > "${package_dir}/installed-before"; \
    grep -Ev '^(git|zlib)-[0-9]' "${package_dir}/installed-before" | sort > "${package_dir}/before"; \
    apk add --no-cache --no-scripts "git=${GIT_VERSION}" "zlib=${ZLIB_VERSION}"; \
    apk --no-network --repositories-file /dev/null info -v > "${package_dir}/installed-after"; \
    test "$(grep -E '^git-[0-9]' "${package_dir}/installed-after")" = "git-${GIT_VERSION}"; \
    test "$(grep -E '^zlib-[0-9]' "${package_dir}/installed-after")" = "zlib-${ZLIB_VERSION}"; \
    grep -Ev '^(git|zlib)-[0-9]' "${package_dir}/installed-after" | sort > "${package_dir}/after"; \
    cmp "${package_dir}/before" "${package_dir}/after"; \
    rm /usr/local/libexec/docker/cli-plugins/docker-buildx /usr/local/libexec/docker/cli-plugins/docker-compose; \
    if test -L /usr/local/bin/docker-compose; then rm /usr/local/bin/docker-compose; fi; \
    for plugin_dir in /usr/local/libexec/docker/cli-plugins /usr/local/lib/docker/cli-plugins /usr/libexec/docker/cli-plugins /usr/lib/docker/cli-plugins /root/.docker/cli-plugins; do \
      for plugin in docker-buildx docker-compose; do test ! -e "${plugin_dir}/${plugin}"; test ! -L "${plugin_dir}/${plugin}"; done; \
    done; \
    test ! -e /usr/local/bin/docker-compose; test ! -L /usr/local/bin/docker-compose; \
    test "$(sha256sum /usr/local/bin/docker | cut -d ' ' -f 1)" = "${docker_sha}"; \
    test "$(sha256sum /etc/ssl/certs/ca-certificates.crt | cut -d ' ' -f 1)" = "${ca_sha}"; \
    docker --version; git --version; \
    rm "${package_dir}/before" "${package_dir}/after" "${package_dir}/installed-before" "${package_dir}/installed-after" "${package_dir}/empty-config"; \
    rmdir "${package_dir}"
COPY --from=build /runtime /usr/local/bin/autosoft-runtime
USER 10001:10001
ENTRYPOINT ["/usr/local/bin/autosoft-runtime"]
