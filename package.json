{
  "name": "autosoft-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "tsx apps/control/src/main.ts",
    "dev:ui": "vite --config apps/admin/vite.config.ts --configLoader native",
    "worker": "tsx apps/control/src/worker-main.ts",
    "typecheck": "tsc --noEmit && tsc -p apps/admin/tsconfig.json --noEmit && tsc -p apps/admin/test/tsconfig.json --noEmit",
    "build": "npm run typecheck && vite build --config apps/admin/vite.config.ts --configLoader native",
    "test": "tsx --test packages/core/test/*.test.ts apps/control/test/*.test.ts tools/*.test.ts && node --test scripts/keycloak-provision.test.mjs && npm run test:ui",
    "test:ui": "tsx --tsconfig apps/admin/tsconfig.json --test apps/admin/test/*.test.tsx",
    "qualify:models": "tsx tools/qualify-models.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "audit:release": "python3 -I -B scripts/public-npm-advisories.py --lock package-lock.json --reviewed-public-packages models/platform-reviewed-public-npm.json"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/helmet": "^13.1.2",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "10.1.10",
    "amqplib": "^2.2.0",
    "dotenv": "^18.0.7",
    "fastify": "^5.12.5",
    "ioredis": "^6.0.0",
    "jose": "^6.2.12",
    "lucide-react": "^1.55.0",
    "mysql2": "^3.24.5",
    "prom-client": "^15.1.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "tsx": "^4.23.15",
    "yaml": "^2.9.1",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/andreitex/-doxentriq.git"
  }
}
