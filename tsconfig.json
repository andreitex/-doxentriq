{
  "compilerOptions": {
    "target": "ES2023", "module": "NodeNext", "moduleResolution": "NodeNext",
    "strict": true, "noUncheckedIndexedAccess": true, "esModuleInterop": true,
    "resolveJsonModule": true, "skipLibCheck": true, "jsx": "react-jsx",
    "noEmit": true, "types": ["node"], "allowImportingTsExtensions": true
  },
  "include": ["packages/**/*.ts", "apps/control/**/*.ts", "tools/**/*.ts"],
  "exclude": ["node_modules", "dist", "generated"]
}
